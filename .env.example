# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# IMPORTANT : utiliser le transaction pooler (port 6543) pour éviter
# "too many clients already" en dev/prod. Le port 5432 (session mode) sature
# rapidement avec le HMR Next.js.
# Format Supabase pooler : postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project:your_password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ─── IA — Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Encryption ───────────────────────────────────────────────────
# Générer via: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=your_32_bytes_base64_key

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Google AI (Gemini) ───────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ─── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_... # ou sk_test_ en dev
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... # ou pk_test_ en dev
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Stripe Products & Prices (grille 5 paliers) ──────────────────
# À créer manuellement dans le dashboard Stripe.
# Procédure complète : voir docs/internal/stripe-setup.md (étape 17)

# Plan Starter — 149 €/mois (mensuel) ou 127 €/mois (annuel) — pas de setup
STRIPE_PRODUCT_STARTER=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=

# Plan Pro ⭐ — 449 €/mois ou 382 €/mois (annuel) + 290€ setup one-shot
STRIPE_PRODUCT_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_SETUP=

# Plan Business — 1 190 €/mois ou 1 012 €/mois (annuel) + 690€ setup one-shot
STRIPE_PRODUCT_BUSINESS=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_BUSINESS_SETUP=

# Voice pack — option Marine sur plan Starter (200 min — 99€ one-shot)
STRIPE_PRICE_VOICE_PACK=

# ─── Cost protection (interne, jamais exposé client) ──────────────
# Mode : 'alert' = notifications uniquement (publication initiale)
#        'active' = bascules auto modèles éco + hard cap (à activer après calibration)
COST_PROTECTION_MODE=alert
COST_PROTECTION_ADMIN_EMAIL=support@lynarisai.com

# ─── Provider pricing (mise à jour sans redéploiement) ────────────
# Anthropic — prix par 1M tokens en euros HT
ANTHROPIC_PRICE_OPUS_INPUT_PER_M=14
ANTHROPIC_PRICE_OPUS_OUTPUT_PER_M=70
ANTHROPIC_PRICE_SONNET_INPUT_PER_M=2.8
ANTHROPIC_PRICE_SONNET_OUTPUT_PER_M=14
ANTHROPIC_PRICE_HAIKU_INPUT_PER_M=0.7
ANTHROPIC_PRICE_HAIKU_OUTPUT_PER_M=3.5

# Replicate — prix par génération en euros HT
REPLICATE_PRICE_FLUX_PRO=0.04
REPLICATE_PRICE_FLUX_SCHNELL=0.003
REPLICATE_PRICE_RUNWAY_5S=0.95

# Twilio — prix par minute / SMS en euros HT
TWILIO_PRICE_VOICE_INBOUND_FR=0.014
TWILIO_PRICE_VOICE_OUTBOUND_FR=0.030
TWILIO_PRICE_SMS=0.045

# ElevenLabs — prix par caractère en euros HT
ELEVENLABS_PRICE_PER_CHAR=0.0006

# Deepgram — prix par minute Nova-2 en euros HT
DEEPGRAM_PRICE_PER_MIN=0.0043

# ─── Gmail SMTP ───────────────────────────────────────────────────
GMAIL_USER=support@yourdomain.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ─── Twilio (voix + SMS) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx...
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WEBHOOK_BASE_URL=https://your-app.vercel.app
TWILIO_FR_BUNDLE_SID=BUxxx...
TWILIO_FR_ADDRESS_SID=ADxxx...

# ─── ElevenLabs (voix IA) ─────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Deepgram (transcription) ─────────────────────────────────────
DEEPGRAM_API_KEY=

# ─── Pipedream Connect ────────────────────────────────────────────
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=

# ─── Upstash Redis (rate limiting) ────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# ─── Cron Secret ──────────────────────────────────────────────────
CRON_SECRET=random_secret_min_32_chars

# ─── Webhooks ─────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=
MAKE_WEBHOOK_SECRET=

# ─── Monitoring (optionnel) ───────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_DATASET=lynaris-logs
AXIOM_TOKEN=

# ─── Image generation (Max) ───────────────────────────────────────
REPLICATE_API_TOKEN=

# ─── Admin ────────────────────────────────────────────────────────
ADMIN_EMAILS=your@email.com

# ─── OAuth Intégrations (via Pipedream Connect — optionnel) ───────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
