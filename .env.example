# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development


# ─── Supabase ─────────────────────────────────────────────────────
# Récupérer depuis app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# IMPORTANT : utiliser le transaction pooler (port 6543) pour éviter
# "too many clients already" en dev/prod. Le port 5432 (session mode)
# sature rapidement avec le HMR Next.js.
# Format pooler : postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project:your_password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres


# ─── IA — Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...


# ─── Encryption ───────────────────────────────────────────────────
# 32 bytes base64 — générer via : openssl rand -base64 32
# ATTENTION : changer cette clé invalide tous les tokens OAuth chiffrés en DB
INTEGRATIONS_ENCRYPTION_KEY=your_32_bytes_base64_key


# ─── OpenAI (ChatGPT) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...


# ─── Google AI (Gemini) ───────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...


# ─── Stripe ───────────────────────────────────────────────────────
# sk_test_ en dev, sk_live_ en prod
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — à créer dans dashboard.stripe.com → Catalogue produits
STRIPE_PRICE_ESSENTIEL_MONTHLY=price_
STRIPE_PRICE_ESSENTIEL_YEARLY=price_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_YEARLY=price_
STRIPE_PRICE_CABINET_MONTHLY=price_
STRIPE_PRICE_CABINET_YEARLY=price_
STRIPE_PHONE_NUMBER_PRICE_ID=


# ─── Gmail SMTP (transactionnel principal) ────────────────────────
# Générer un App Password : myaccount.google.com → Sécurité → Validation 2 étapes → Mots de passe d'application
GMAIL_USER=support@yourdomain.com
GMAIL_APP_PASSWORD=your_16_chars_app_password


# ─── Admin Lynaris ────────────────────────────────────────────────
# Liste séparée par virgules des emails admin (accès /dashboard/admin)
ADMIN_EMAILS=admin@yourdomain.com
EMAIL_LOGO_URL=https://your-cdn.com/logo.png


# ─── Twilio (téléphonie Marine) ───────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WEBHOOK_BASE_URL=https://your-app.vercel.app
TWILIO_FR_BUNDLE_SID=BU...
TWILIO_FR_ADDRESS_SID=AD...
TWILIO_MESSAGING_SERVICE_SID=MG...


# ─── WhatsApp Business ────────────────────────────────────────────
# Token de vérification pour les webhooks entrants WhatsApp (pas un OAuth credential)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token


# ─── Resend (emails — fallback) ───────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=support@yourdomain.com
RESEND_FROM_NAME=Lynaris


# ─── Google OAuth (Gmail, Calendar, Drive — flux natif) ───────────
# console.cloud.google.com → APIs & Services → Credentials
# Les autres providers OAuth sont gérés par Pipedream (voir section ci-dessous).
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret


# ─── Voix & Transcription (optionnel) ─────────────────────────────
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=


# ─── Webhooks tiers (optionnel) ───────────────────────────────────
N8N_WEBHOOK_SECRET=
MAKE_WEBHOOK_SECRET=


# ─── Cron interne ─────────────────────────────────────────────────
# Générer un token aléatoire fort en prod
CRON_SECRET=dev-secret-local


# ─── Voice WebSocket ──────────────────────────────────────────────
VOICE_WS_PORT=3001


# ─── Monitoring (optionnel) ───────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_DATASET=lynaris-logs
AXIOM_TOKEN=


# ─── Génération d'images & vidéos (Max) ──────────────────────────
# replicate.com → Account Settings → API tokens
REPLICATE_API_TOKEN=r8_...


# ─── Upstash Redis (rate limiting) ────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─── Pipedream Connect (toutes les intégrations OAuth tierces) ────
# pipedream.com → Settings → OAuth Clients → Créer un client
# Tous les providers (Slack, Notion, HubSpot, LinkedIn, Instagram,
# Salesforce, Airtable, GitHub, etc.) sont connectés via Pipedream.
# Aucun CLIENT_ID/SECRET individuel requis dans le .env.
PIPEDREAM_CLIENT_ID=your_pipedream_client_id
PIPEDREAM_CLIENT_SECRET=your_pipedream_client_secret
PIPEDREAM_PROJECT_ID=proj_...
# Optionnel — "production" force le mode prod même sans NODE_ENV=production
# PIPEDREAM_ENVIRONMENT=production
