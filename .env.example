# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ─── IA — Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Encryption ───────────────────────────────────────────────────
# Générer via: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=your_32_bytes_base64_key

# ─── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Google AI (Gemini) ───────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...

# ─── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_... # ou sk_test_ en dev
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... # ou pk_test_ en dev
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Stripe price IDs (nouvelle grille 5 paliers) ─────────────────
# À créer dans le dashboard Stripe puis renseigner ici.
# Le script `scripts/stripe/create-products.ts` (étape 0) peut générer
# les produits + prix automatiquement via l'API Stripe.

# Plan Starter — 149 €/mois (mensuel) ou 127 €/mois (engagement annuel)
STRIPE_PRODUCT_STARTER=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=

# Plan Pro (NOUVEAU 449€) — 449 €/mois ou 382 €/mois (annuel) + 290€ setup
STRIPE_PRODUCT_PRO_NEW=
STRIPE_PRICE_PRO_NEW_MONTHLY=
STRIPE_PRICE_PRO_NEW_YEARLY=
STRIPE_PRICE_PRO_NEW_SETUP_FEE=

# Plan Business — 1 190 €/mois ou 1 012 €/mois (annuel) + 690€ setup
STRIPE_PRODUCT_BUSINESS=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_BUSINESS_SETUP_FEE=

# ─── Anciens price IDs (rétrocompat subscriptions historiques) ────
# Pro 149€ (ancien) — clients grandfathered. Voir legacy-mapping.ts.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ─── Gmail SMTP ───────────────────────────────────────────────────
GMAIL_USER=support@yourdomain.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ─── Twilio (voix + SMS) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx...
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WEBHOOK_BASE_URL=https://your-app.vercel.app
TWILIO_FR_BUNDLE_SID=BUxxx...
TWILIO_FR_ADDRESS_SID=ADxxx...

# ─── ElevenLabs (voix IA) ─────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Deepgram (transcription) ─────────────────────────────────────
DEEPGRAM_API_KEY=

# ─── Pipedream Connect ────────────────────────────────────────────
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=

# ─── Upstash Redis (rate limiting) ────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# ─── Cron Secret ──────────────────────────────────────────────────
CRON_SECRET=random_secret_min_32_chars

# ─── Webhooks ─────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=
MAKE_WEBHOOK_SECRET=

# ─── Monitoring (optionnel) ───────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_DATASET=lynaris-logs
AXIOM_TOKEN=

# ─── Image generation (Max) ───────────────────────────────────────
REPLICATE_API_TOKEN=

# ─── Admin ────────────────────────────────────────────────────────
ADMIN_EMAILS=your@email.com

# ─── OAuth Intégrations (via Pipedream Connect — optionnel) ───────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
