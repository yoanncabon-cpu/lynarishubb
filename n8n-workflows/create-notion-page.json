        "jsonBody": "={{ JSON.stringify({ children: [{ object: 'block', type: 'paragraph', paragraph: { rich_text: [{ type: 'text', text: { content: $('Extract Data').item.json.content } }] } }] }) }}",
        "options": {}
      },
