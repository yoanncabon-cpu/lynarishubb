{
  "name": "Lynaris — Publish TikTok",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-tiktok",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "f0e1d2c3-3001-4c01-b003-webhook000001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "video_url", "value": "={{ $json.data.video_url }}", "type": "string" },
            { "id": "2", "name": "caption", "value": "={{ $json.data.caption }}", "type": "string" },
            { "id": "3", "name": "privacy_level", "value": "={{ $json.data.privacy_level || 'PUBLIC_TO_EVERYONE' }}", "type": "string" },
            { "id": "4", "name": "org_id", "value": "={{ $json.org_id }}", "type": "string" },
            { "id": "5", "name": "run_id", "value": "={{ $json.run_id }}", "type": "string" },
            { "id": "6", "name": "timestamp", "value": "={{ $json.timestamp }}", "type": "string" }
          ]
        }
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000002",
      "name": "Extract Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.TIKTOK_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ post_info: { title: $json.caption, privacy_level: $json.privacy_level, disable_duet: false, disable_comment: false, disable_stitch: false }, source_info: { source: 'PULL_FROM_URL', video_url: $json.video_url } }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000003",
      "name": "Init TikTok Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000004",
      "name": "Wait for Processing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/status/fetch/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.TIKTOK_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ publish_id: $('Init TikTok Upload').item.json.data.publish_id }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000005",
      "name": "Check Publish Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LYNARIS_CALLBACK_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Extract Data').item.json.run_id, org_id: $('Extract Data').item.json.org_id, workflow: 'publish-tiktok', status: 'success', output: { publish_id: $('Init TikTok Upload').item.json.data.publish_id, status: $json.data.status }, duration_ms: Date.now() - new Date($('Extract Data').item.json.timestamp).getTime() }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000006",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', run_id: $('Extract Data').item.json.run_id }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000009",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1560, 300]
    },
    {
      "parameters": {},
      "id": "c3d4e5f6-3001-4c01-b003-000000000007",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [900, 540]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LYNARIS_CALLBACK_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'publish-tiktok', status: 'error', error: $json.message || 'Unknown error' }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-3001-4c01-b003-000000000008",
      "name": "Callback Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 540]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Extract Data", "type": "main", "index": 0 }]] },
    "Extract Data": { "main": [[{ "node": "Init TikTok Upload", "type": "main", "index": 0 }]] },
    "Init TikTok Upload": { "main": [[{ "node": "Wait for Processing", "type": "main", "index": 0 }]] },
    "Wait for Processing": { "main": [[{ "node": "Check Publish Status", "type": "main", "index": 0 }]] },
    "Check Publish Status": { "main": [[{ "node": "Callback Success", "type": "main", "index": 0 }]] },
    "Callback Success": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Callback Error", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "lynaris" }, { "name": "content" }, { "name": "tiktok" }]
}