{
  "name": "Lynaris — Send SMS",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-sms",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f6a7b8c9-6001-4f01-b006-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "f0e1d2c3-6001-4f01-b006-webhook000001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "to", "value": "={{ $json.data.to }}", "type": "string" },
            { "id": "2", "name": "body", "value": "={{ $json.data.body }}", "type": "string" },
            { "id": "3", "name": "from", "value": "={{ $json.data.from || $env.TWILIO_FROM_NUMBER }}", "type": "string" },
            { "id": "4", "name": "org_id", "value": "={{ $json.org_id }}", "type": "string" },
            { "id": "5", "name": "run_id", "value": "={{ $json.run_id }}", "type": "string" },
            { "id": "6", "name": "timestamp", "value": "={{ $json.timestamp }}", "type": "string" }
          ]
        }
      },
      "id": "f6a7b8c9-6001-4f01-b006-000000000002",
      "name": "Extract Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $env.TWILIO_ACCOUNT_SID }}/Messages.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Basic {{ Buffer.from($env.TWILIO_ACCOUNT_SID + ':' + $env.TWILIO_AUTH_TOKEN).toString('base64') }}" },
            { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "=To={{ encodeURIComponent($json.to) }}&From={{ encodeURIComponent($json.from) }}&Body={{ encodeURIComponent($json.body) }}",
        "options": {}
      },
      "id": "f6a7b8c9-6001-4f01-b006-000000000003",
      "name": "Send SMS Twilio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LYNARIS_CALLBACK_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Extract Data').item.json.run_id, org_id: $('Extract Data').item.json.org_id, workflow: 'send-sms', status: 'success', output: { message_sid: $json.sid, to: $json.to, status: $json.status }, duration_ms: Date.now() - new Date($('Extract Data').item.json.timestamp).getTime() }) }}",
        "options": {}
      },
      "id": "f6a7b8c9-6001-4f01-b006-000000000004",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', run_id: $('Extract Data').item.json.run_id }) }}",
        "options": {}
      },
      "id": "f6a7b8c9-6001-4f01-b006-000000000007",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    },
    {
      "parameters": {},
      "id": "f6a7b8c9-6001-4f01-b006-000000000005",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [680, 540]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LYNARIS_CALLBACK_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'send-sms', status: 'error', error: $json.message || 'Unknown error' }) }}",
        "options": {}
      },
      "id": "f6a7b8c9-6001-4f01-b006-000000000006",
      "name": "Callback Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 540]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Extract Data", "type": "main", "index": 0 }]] },
    "Extract Data": { "main": [[{ "node": "Send SMS Twilio", "type": "main", "index": 0 }]] },
    "Send SMS Twilio": { "main": [[{ "node": "Callback Success", "type": "main", "index": 0 }]] },
    "Callback Success": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Callback Error", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "lynaris" }, { "name": "sms" }, { "name": "twilio" }]
}