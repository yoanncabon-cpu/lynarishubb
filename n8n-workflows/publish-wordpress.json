            { "id": "2", "name": "wp_date", "value": "", "type": "string" }
          ]
        }
      },
      "id": "d4e5f6a7-4001-4d01-b004-000000000005",
      "name": "Set Immediate",
      "type": "n8n-nodes-base.set",
