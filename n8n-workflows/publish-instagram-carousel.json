{
  "name": "Lynaris — Publish Instagram Carousel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-instagram-carousel",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "f0e1d2c3-2001-4b01-b002-webhook000001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "images", "value": "={{ $json.data.images }}", "type": "array" },
            { "id": "2", "name": "caption", "value": "={{ $json.data.caption }}", "type": "string" },
            { "id": "3", "name": "ig_account_id", "value": "={{ $json.data.ig_account_id || $env.INSTAGRAM_ACCOUNT_ID }}", "type": "string" },
            { "id": "4", "name": "org_id", "value": "={{ $json.org_id }}", "type": "string" },
            { "id": "5", "name": "run_id", "value": "={{ $json.run_id }}", "type": "string" },
            { "id": "6", "name": "timestamp", "value": "={{ $json.timestamp }}", "type": "string" }
          ]
        }
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000002",
      "name": "Extract Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "command": "runOnceForEachItem",
        "jsCode": "// Split images array into individual items for container creation\nconst images = $input.first().json.images;\nconst items = images.map((url, i) => ({ json: { image_url: url, index: i, ig_account_id: $input.first().json.ig_account_id, caption: $input.first().json.caption, org_id: $input.first().json.org_id, run_id: $input.first().json.run_id, timestamp: $input.first().json.timestamp } }));\nreturn items;"
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000003",
      "name": "Split Images",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.ig_account_id }}/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.META_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ image_url: $json.image_url, is_carousel_item: true }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000004",
      "name": "Create Media Containers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "mode": "expression",
        "jsCode": "// Collect all container IDs\nconst containerIds = $input.all().map(item => item.json.id);\nconst firstItem = $('Extract Data').first().json;\nreturn [{ json: { container_ids: containerIds, ig_account_id: firstItem.ig_account_id, caption: firstItem.caption, org_id: firstItem.org_id, run_id: firstItem.run_id, timestamp: firstItem.timestamp } }];"
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000005",
      "name": "Collect Container IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.ig_account_id }}/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.META_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ media_type: 'CAROUSEL', children: $json.container_ids, caption: $json.caption }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000006",
      "name": "Create Carousel Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $('Extract Data').item.json.ig_account_id }}/media_publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.META_ACCESS_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ creation_id: $json.id }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000007",
      "name": "Publish Carousel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LYNARIS_CALLBACK_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Extract Data').item.json.run_id, org_id: $('Extract Data').item.json.org_id, workflow: 'publish-instagram-carousel', status: 'success', output: { media_id: $json.id }, duration_ms: Date.now() - new Date($('Extract Data').item.json.timestamp).getTime() }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000008",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', run_id: $('Extract Data').item.json.run_id }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000011",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2000, 300]
    },
    {
      "parameters": {},
      "id": "b2c3d4e5-2001-4b01-b002-000000000009",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [900, 540]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LYNARIS_CALLBACK_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'publish-instagram-carousel', status: 'error', error: $json.message || 'Unknown error' }) }}",
        "options": {}
      },
      "id": "b2c3d4e5-2001-4b01-b002-000000000010",
      "name": "Callback Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 540]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Extract Data", "type": "main", "index": 0 }]] },
    "Extract Data": { "main": [[{ "node": "Split Images", "type": "main", "index": 0 }]] },
    "Split Images": { "main": [[{ "node": "Create Media Containers", "type": "main", "index": 0 }]] },
    "Create Media Containers": { "main": [[{ "node": "Collect Container IDs", "type": "main", "index": 0 }]] },
    "Collect Container IDs": { "main": [[{ "node": "Create Carousel Container", "type": "main", "index": 0 }]] },
    "Create Carousel Container": { "main": [[{ "node": "Publish Carousel", "type": "main", "index": 0 }]] },
    "Publish Carousel": { "main": [[{ "node": "Callback Success", "type": "main", "index": 0 }]] },
    "Callback Success": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Callback Error", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "lynaris" }, { "name": "content" }, { "name": "instagram" }]
}