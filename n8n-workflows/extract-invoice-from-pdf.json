      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.pdf_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "d0e1f2a3-a001-4d01-b010-000000000003",
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "text",
        "options": {}
      },
      "id": "d0e1f2a3-a001-4d01-b010-000000000004",
      "name": "Extract Text from PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-20250414', max_tokens: 1024, messages: [{ role: 'user', content: 'Extract structured invoice data from this text. Return ONLY valid JSON with these fields: invoice_number (string), date (ISO date string), supplier_name (string), supplier_address (string), total_amount (number), currency (string, default EUR), line_items (array of {description, quantity, unit_price, total}), tax_rate (number as percentage), tax_amount (number), notes (string or null).\\n\\nInvoice text:\\n' + $json.data }] }) }}",
        "options": {}
      },
      "id": "d0e1f2a3-a001-4d01-b010-000000000005",
      "name": "Claude Extract Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "command": "runOnceForAllItems",
        "jsCode": "// Parse Claude response to get structured invoice data\nconst response = $input.first().json;\nconst content = response.content[0].text;\n// Extract JSON from the response (handle potential markdown code blocks)\nlet jsonStr = content;\nconst jsonMatch = content.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\nif (jsonMatch) jsonStr = jsonMatch[1];\nconst invoice = JSON.parse(jsonStr.trim());\nreturn [{ json: invoice }];"
      },
      "id": "d0e1f2a3-a001-4d01-b010-000000000006",
      "name": "Parse Invoice JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.NOTION_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Notion-Version", "value": "2022-06-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ parent: { database_id: $('Extract Data').item.json.notion_database_id }, properties: { Name: { title: [{ text: { content: 'Facture ' + ($json.invoice_number || 'N/A') } }] }, 'Numéro': { rich_text: [{ text: { content: $json.invoice_number || '' } }] }, Fournisseur: { rich_text: [{ text: { content: $json.supplier_name || '' } }] }, Montant: { number: $json.total_amount || 0 }, Date: { date: { start: $json.date || new Date().toISOString().split('T')[0] } }, Devise: { select: { name: $json.currency || 'EUR' } } } }) }}",
        "options": {}
      },
      "id": "d0e1f2a3-a001-4d01-b010-000000000007",
      "name": "Create Notion Entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LYNARIS_CALLBACK_URL }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Extract Data').item.json.run_id, org_id: $('Extract Data').item.json.org_id, workflow: 'extract-invoice-from-pdf', status: 'success', output: { notion_page_id: $json.id, invoice_number: $('Parse Invoice JSON').item.json.invoice_number, supplier: $('Parse Invoice JSON').item.json.supplier_name, total: $('Parse Invoice JSON').item.json.total_amount }, duration_ms: Date.now() - new Date($('Extract Data').item.json.timestamp).getTime() }) }}",
        "options": {}
      },
      "id": "d0e1f2a3-a001-4d01-b010-000000000008",
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'accepted', run_id: $('Extract Data').item.json.run_id }) }}",
        "options": {}
      },
      "id": "d0e1f2a3-a001-4d01-b010-000000000011",
      "name": "Respond OK",
